    },
    {
      "id": "compare-rag-text",
      "type": "text",
      "x": 65,
      "y": 1990,
      "width": 370,
      "height": 160,
      "text": "RAG (Retrieval-Augmented Generation)\n\n✓ No training required — instant updates\n✓ Grounded in actual user data\n✓ Source attribution / citations possible\n✓ Works with any base model\n✗ Limited by context window size\n✗ Retrieval quality depends on embeddings\n✗ Higher latency (embed + search + generate)\n\nUsed for: Decision analysis, journal queries,\n         pattern lookups, contextual advice",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#5c940d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "groupIds": ["compare"],
      "roundness": null,
      "seed": 702,
      "version": 1,
      "versionNonce": 702,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RAG (Retrieval-Augmented Generation)\n\n✓ No training required — instant updates\n✓ Grounded in actual user data\n✓ Source attribution / citations possible\n✓ Works with any base model\n✗ Limited by context window size\n✗ Retrieval quality depends on embeddings\n✗ Higher latency (embed + search + generate)\n\nUsed for: Decision analysis, journal queries,\n         pattern lookups, contextual advice",
      "autoResize": true,
      "lineHeight": 1.25
    },

