    {
      "id": "lora-detail-box",
      "type": "rectangle",
      "x": 50,
      "y": 950,
      "width": 1400,
      "height": 70,
      "strokeColor": "#868e96",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
