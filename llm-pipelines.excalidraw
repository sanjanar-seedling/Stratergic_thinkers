    {
      "id": "compare-ft-text",
      "type": "text",
      "x": 505,
      "y": 1990,
      "width": 370,
      "height": 160,
      "text": "Fine-Tuning (LoRA Adapters)\n\n✓ Learns user's thinking style / vocabulary\n✓ Lower inference latency (no retrieval step)\n✓ Better at tone / personality matching\n✓ Small adapter size (~100MB per user)\n✗ Requires sufficient training data\n✗ Training takes time (background job)\n✗ Can overfit to user's biases\n\nUsed for: Personalized communication style,\n         adaptive challenge calibration,\n         founder-specific reasoning patterns",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#862e9c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "groupIds": ["compare"],
      "roundness": null,
      "seed": 704,
      "version": 1,
      "versionNonce": 704,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fine-Tuning (LoRA Adapters)\n\n✓ Learns user's thinking style / vocabulary\n✓ Lower inference latency (no retrieval step)\n✓ Better at tone / personality matching\n✓ Small adapter size (~100MB per user)\n✗ Requires sufficient training data\n✗ Training takes time (background job)\n✗ Can overfit to user's biases\n\nUsed for: Personalized communication style,\n         adaptive challenge calibration,\n         founder-specific reasoning patterns",
      "autoResize": true,
      "lineHeight": 1.25
    },

