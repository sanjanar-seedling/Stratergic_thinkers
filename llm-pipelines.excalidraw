    {
      "id": "rag-detail-text",
      "type": "text",
      "x": 70,
      "y": 660,
      "width": 1330,
      "height": 60,
      "text": "RAG Flow Detail (rag_pipeline.py):  User query → PII stripped → embedded via LangChain → cosine similarity search in pgvector (top-k=5)\n→ Retrieved chunks ranked by relevance score → Context window assembled with system prompt + retrieved docs + user cognitive profile\n→ State-aware prompter injects bias warnings + conversation history → LLM generates response grounded in user's own data (zero hallucination on user facts)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "groupIds": ["rag"],
      "roundness": null,
      "seed": 216,
      "version": 1,
      "versionNonce": 216,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RAG Flow Detail (rag_pipeline.py):  User query → PII stripped → embedded via LangChain → cosine similarity search in pgvector (top-k=5)\n→ Retrieved chunks ranked by relevance score → Context window assembled with system prompt + retrieved docs + user cognitive profile\n→ State-aware prompter injects bias warnings + conversation history → LLM generates response grounded in user's own data (zero hallucination on user facts)",
      "autoResize": true,
      "lineHeight": 1.25
    },



