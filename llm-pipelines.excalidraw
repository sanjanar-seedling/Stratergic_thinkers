    },
    {
      "id": "lora-detail-text",
      "type": "text",
      "x": 70,
      "y": 958,
      "width": 1360,
      "height": 50,
      "text": "LoRA Fine-Tuning Detail:  Unlike full fine-tuning (which retrains all model weights), LoRA freezes the base model and trains small rank-decomposition matrices (A×B)\ninserted into attention layers. This means: (1) Only ~0.1% of parameters are trained  (2) Each user gets their own tiny adapter  (3) Base model stays shared\n(4) Adapters can be loaded/unloaded dynamically at inference time  (5) Training runs on background workers via APScheduler without blocking the API",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "groupIds": ["finetune"],
      "roundness": null,
      "seed": 316,
      "version": 1,
      "versionNonce": 316,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LoRA Fine-Tuning Detail:  Unlike full fine-tuning (which retrains all model weights), LoRA freezes the base model and trains small rank-decomposition matrices (A×B)\ninserted into attention layers. This means: (1) Only ~0.1% of parameters are trained  (2) Each user gets their own tiny adapter  (3) Base model stays shared\n(4) Adapters can be loaded/unloaded dynamically at inference time  (5) Training runs on background workers via APScheduler without blocking the API",
      "autoResize": true,
      "lineHeight": 1.25
    },



