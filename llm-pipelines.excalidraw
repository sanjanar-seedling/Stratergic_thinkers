    {
      "id": "e2e-box",
      "type": "rectangle",
      "x": 50,
      "y": 1680,
      "width": 1370,
      "height": 220,
      "strokeColor": "#1971c2",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "groupIds": ["e2e"],
      "roundness": { "type": 3 },
      "seed": 601,
