# ============================================================
# Seedlings Platform - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Discord OAuth & Bot
# ------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_BOT_INVITE_LINK=

# ------------------------------------------------------------
# Slack OAuth & Bot
# ------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Local development tokens (from Slack app settings)
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=

# ------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_URL=http://localhost:3333
GOOGLE_URI=http://localhost:3000/auth/callback

# ------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://seedlings:seedlings_dev_2024@localhost:5432/seedlings
DATABASE_SCHEMA=seedlings

# Docker Compose postgres credentials (must match DATABASE_URL)
POSTGRES_USER=seedlings
POSTGRES_PASSWORD=seedlings_dev_2024
POSTGRES_DB=seedlings

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_STREAM_NAME=seedlings:events

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------
# LLM Provider: "groq" (fast cloud), "openai" (cloud), or "ollama" (local/free)
# ------------------------------------------------------------
LLM_PROVIDER=groq

# Groq (required if LLM_PROVIDER=groq — also used for voice transcription)
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Ollama (used for embeddings fallback, or if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=tinyllama
OLLAMA_EMBED_MODEL=nomic-embed-text

# ------------------------------------------------------------
# MinIO / S3 Object Storage
# ------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=seedlings
S3_SECRET_KEY=seedlings_dev_2024
S3_BUCKET=seedlings-uploads

# Docker Compose MinIO credentials (must match S3 keys above)
MINIO_ROOT_USER=seedlings
MINIO_ROOT_PASSWORD=seedlings_dev_2024

# ------------------------------------------------------------
# Email Ingestion (IMAP)
# ------------------------------------------------------------
IMAP_SERVER=imap.gmail.com
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# ------------------------------------------------------------
# Voice Transcription
# ------------------------------------------------------------
# "groq" (uses GROQ_API_KEY), "openai" (uses OPENAI_API_KEY), or "local"
WHISPER_PROVIDER=groq

# ------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME=Seedlings API
DEBUG=true
API_PREFIX=/api

# ------------------------------------------------------------
# OAuth Redirect URIs
# ------------------------------------------------------------
SLACK_REDIRECT_URI=https://localhost:5173/oauth/callback
DISCORD_REDIRECT_URI=https://localhost:5173/oauth/callback
GOOGLE_REDIRECT_URI=https://localhost:5173/oauth/callback
