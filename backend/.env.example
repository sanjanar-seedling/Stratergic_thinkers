# Application
APP_NAME="Seedlings API"
DEBUG=true
API_PREFIX="/api"

# Database
DATABASE_URL="postgresql+asyncpg://seedlings:seedlings_dev_2024@localhost:5432/seedlings"
DATABASE_SCHEMA="seedlings"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_STREAM_NAME="seedlings:events"

# Security
SECRET_KEY="dev-secret-key-change-in-production-use-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider: "ollama" (local/free) or "openai" (cloud)
LLM_PROVIDER="ollama"

# OpenAI (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
CHAT_MODEL="gpt-4o-mini"

# Ollama (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="tinyllama"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="seedlings"
S3_SECRET_KEY="seedlings_dev_2024"
S3_BUCKET="seedlings-uploads"

# OAuth - Slack
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:5173/oauth/callback"

# OAuth - Discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:5173/oauth/callback"

# OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/oauth/callback"

# Email Ingestion
IMAP_SERVER="imap.gmail.com"
EMAIL_ADDRESS=""
EMAIL_PASSWORD=""

# Voice Transcription
WHISPER_PROVIDER="openai"  # "openai" or "local"
